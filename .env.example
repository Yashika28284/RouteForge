# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=routeforge
POSTGRES_USER=routeforge
POSTGRES_PASSWORD=change_me_in_prod

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# --- Backend ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Optimize service (Python/OR-Tools) ---
OPTIMIZE_SERVICE_URL=http://optimize-service:8000

# --- OSRM (public demo server by default — self-host for production use) ---
OSRM_BASE_URL=https://router.project-osrm.org

# --- Nominatim geocoding ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=routeforge-app

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:4000/api
