# --- Postgres ---
# Local Docker Compose: use the discrete vars below.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=routeforge
POSTGRES_USER=routeforge
POSTGRES_PASSWORD=change_me_in_prod
# Managed Postgres (e.g. Neon): set DATABASE_URL instead (takes priority
# over the discrete vars above) and POSTGRES_SSL=true. Certificates are
# fully verified by default (secure) — only set POSTGRES_SSL_INSECURE=true
# if your provider uses a self-signed cert Node can't verify; never set it
# for Neon.
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/routeforge?sslmode=require
# POSTGRES_SSL=true
# POSTGRES_SSL_INSECURE=false

# --- Redis ---
# Local Docker Compose:
REDIS_URL=redis://redis:6379
# Managed Redis (e.g. Upstash): use the rediss:// (TLS) URL from your
# Upstash dashboard, e.g. REDIS_URL=rediss://default:<password>@<host>:6379

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# --- Backend ---
PORT=4000
NODE_ENV=development
# Comma-separated exact origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
# Optional: regex tested against the request origin, for preview URLs
# (e.g. one new URL per Vercel deploy). Scope it to your own project —
# do NOT use a broad pattern like ^https://.*\.vercel\.app$, or you'll
# trust any site hosted on Vercel.
# CORS_ORIGIN_REGEX=^https://routeforge-git-[a-z0-9-]+-yourteam\.vercel\.app$

# --- Optimize service (Python/OR-Tools) ---
OPTIMIZE_SERVICE_URL=http://optimize-service:8000

# --- OSRM (public demo server by default — self-host for production use) ---
OSRM_BASE_URL=https://router.project-osrm.org

# --- Nominatim geocoding ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=routeforge-app

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:4000/api
